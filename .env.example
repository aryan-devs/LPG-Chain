# ====================================================================
# LPG-Chain — Environment Configuration Template (.env.example)
# Zero-Cost College/Project Prototype Environment Variables
# Copy this file to .env and configure local values as needed.
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (MySQL)
# --------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/lpg_chain?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --------------------------------------------------------------------
# 2. Security & JWT Settings
# --------------------------------------------------------------------
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRATION=86400000
PASSWORD_PEPPER=your_secure_password_pepper_random_secret_48c_min

# --------------------------------------------------------------------
# 3. Google OAuth 2.0 / OpenID Connect (Optional - Zero-cost Prototype)
# Leave blank to use email/password login. Set if testing Google sign-in.
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --------------------------------------------------------------------
# 4. Local Ollama AI Assistant (Free, Local LLM)
# Default is http://localhost:11434 with llama3.2 or mistral.
# If Ollama is not running, the assistant gracefully falls back to grounded DB retrieval.
# --------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------------------------
# 5. Machine Learning Demand Forecasting Service (FastAPI)
# --------------------------------------------------------------------
ML_FORECAST_URL=http://localhost:8000/forecast

# --------------------------------------------------------------------
# 6. KYC Document File Storage
# Directory where uploaded citizen identity documents are stored securely.
# --------------------------------------------------------------------
DOCUMENT_UPLOAD_DIR=uploads/documents

# --------------------------------------------------------------------
# 7. Redis & Real-Time Tracking (Optional)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------------
# 8. SMS & Delivery Notification Provider (Dev / Twilio)
# "dev" logs OTPs safely to server logs without paid external SMS charges.
# --------------------------------------------------------------------
LPGCHAIN_NOTIFICATION_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
