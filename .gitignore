# ==========================================
# LPG-Chain (.gitignore)
# ==========================================

# --- Compiled Java / Maven Output ---
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# --- Node.js & Dependencies ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Frontend Build / Dist Outputs ---
dist/
**/dist/
build/
**/build/
out/
**/out/
.parcel-cache/
.next/
.nuxt/
.turbo/

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
!.env.template
*.env
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore

# --- Local developer secrets (Spring Boot env overrides) ---
# Place DB_URL / DB_USERNAME / DB_PASSWORD here — never commit this file.
backend/.env
backend/**/.env
frontend/.env
frontend/.env.*
frontend/**/.env
ml/.env
ml/**/.env
**/application-local.properties
!**/.env.example
!**/.env.template

# --- Uploaded Documents & Citizen KYC PII ---
uploads/
**/uploads/
backend/uploads/

# --- Python & ML Environments ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/venv/
**/ENV/
**/env/
ml/.venv/
*.egg-info/

# --- Local Database Files & Dumps ---
*.db
*.sqlite
*.sqlite3
*.h2.db
*.dump
*.sql.gz

# --- IDE & Editor Files ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS-Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Logs & Runtime Data ---
logs/
**/logs/
*.log

# --- Testing & Coverage ---
coverage/
**/coverage/
*.lcov
.nyc_output/

# --- Explicit Inclusions ---
!**/src/
!**/src/**
!pom.xml
!**/pom.xml
!package.json
!**/package.json
!package-lock.json
!**/package-lock.json
!README.md
!**/README.md
!docs/
!docs/**
